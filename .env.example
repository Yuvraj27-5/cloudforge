# Copy to .env and adjust. Never commit .env.
# Local development values only. Cloud secrets come from
# AWS Secrets Manager / Azure Key Vault / GitHub Actions Secrets.

POSTGRES_DB=cloudforge
POSTGRES_USER=cloudforge
POSTGRES_PASSWORD=local_dev_only_change_me
POSTGRES_PORT=5433

# Sample app, started only with: docker compose --profile sample up -d --build
SAMPLE_APP_PORT=3000
SAMPLE_FAILURE_MODE=none
SAMPLE_FAILURE_DELAY_SECONDS=30
